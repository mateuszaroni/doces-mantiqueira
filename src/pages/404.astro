---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { mensagens } from '../config';
---

<Base
  titulo="Página não encontrada — Doces Mantiqueira, Piquete"
  descricao="Esta página não existe. Volte para o início ou fale com o Felipe no WhatsApp."
  indexar={false}
>
  <Cabecalho base="/" />
  <main id="conteudo" class="nao-encontrada">
    <div class="envelope">
      <h1>Esta página não existe</h1>
      <p>O endereço pode ter mudado ou estar com erro de digitação. Os doces continuam na página inicial.</p>
      <div class="nao-encontrada__acoes">
        <a class="botao botao--creme" href="/">Voltar para o início</a>
        <BotaoWhatsApp variante="contorno" mensagem={mensagens.geral} rotulo="Pedir no WhatsApp" />
      </div>
    </div>
  </main>
</Base>

<style>
  .nao-encontrada {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--altura-cabecalho) + 3rem) 4rem;
    background: var(--vermelho);
    color: var(--creme);
  }

  h1 {
    max-width: 10ch;
    font-size: var(--t-secao);
  }

  p {
    max-width: 40ch;
    margin-top: 1.5rem;
    font-size: var(--t-grande);
  }

  .nao-encontrada__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
</style>
