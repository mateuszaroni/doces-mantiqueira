---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Topo from '../components/Topo.astro';
import Vitrine from '../components/Vitrine.astro';
import Historia from '../components/Historia.astro';
---

<Base
  titulo="Doces Mantiqueira — doces caseiros de Piquete, na Serra da Mantiqueira"
  descricao="Doces caseiros feitos de forma artesanal em Piquete (SP), no pé da Serra da Mantiqueira, desde 1985. Paçoca, cajuzinho, doce de leite, de abóbora, de batata e mais. Peça pelo WhatsApp."
>
  <Cabecalho />
  <main id="conteudo">
    <Topo />
    <Vitrine />
    <Historia />
  </main>
</Base>
