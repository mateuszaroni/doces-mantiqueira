---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Vitrine from '../components/Vitrine.astro';
import Historia from '../components/Historia.astro';
import Festas from '../components/Festas.astro';
import Revenda from '../components/Revenda.astro';
import OndeEstamos from '../components/OndeEstamos.astro';
import Rodape from '../components/Rodape.astro';
import WhatsAppFlutuante from '../components/WhatsAppFlutuante.astro';
import DadosEstruturados from '../components/DadosEstruturados.astro';
---

<Base
  titulo="Doces Mantiqueira — doces caseiros de Piquete, na Serra da Mantiqueira"
  descricao="Doces caseiros feitos de forma artesanal em Piquete (SP), no pé da Serra da Mantiqueira, desde 1985. Paçoca, cajuzinho, doce de leite, de abóbora, de batata e mais. Peça pelo WhatsApp."
>
  <DadosEstruturados slot="head" />
  <main id="conteudo">
    <Topo />
    <Vitrine />
    <Historia />
    <Festas />
    <Revenda />
    <OndeEstamos />
  </main>
  <Rodape />
  <WhatsAppFlutuante />
</Base>
