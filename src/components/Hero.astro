---
import { Image } from 'astro:assets';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import Filete from './Filete.astro';
import { mensagens } from '../config';
import figo from '../assets/recortes/figo.webp';
import pacoca from '../assets/recortes/pacoca-tigela.webp';
import sortida from '../assets/recortes/sortida.webp';
import serraFundo from '../assets/fundo/serra-fundo.svg';

// A bandeja sortida fica na frente do grupo e é o maior elemento: prioridade alta.
const larguras = [280, 420, 640, 900];
const qualidade = 75;
---

<section class="hero" id="topo" aria-labelledby="hero-titulo">
  <img class="hero__serra" src={serraFundo.src} width="1600" height="640" alt="" fetchpriority="low" />

  <div class="hero__grade">
    <div class="hero__texto">
      <h1 class="hero__titulo" id="hero-titulo" translate="no"><span>Doces</span> <span>Mantiqueira</span></h1>
      <Filete class="hero__filete" />
      <p class="hero__apoio">Doces caseiros da Serra da Mantiqueira, desde 1985.</p>
      <div class="hero__acoes">
        <BotaoWhatsApp variante="linha" mensagem={mensagens.varejo} rotulo="Pedir / orçamento para festa" />
        <a class="hero__revenda" href="#revenda">
          Quero revender
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>

    <div class="hero__palco">
      <Image
        class="recorte recorte--pacoca"
        src={pacoca}
        widths={larguras}
        quality={qualidade}
        sizes="(max-width: 760px) 52vw, 24vw"
        alt="Paçoca de amendoim numa tigela vermelha, com amendoins em volta"
        loading="eager"
      />
      <Image
        class="recorte recorte--figo"
        src={figo}
        widths={larguras}
        quality={qualidade}
        sizes="(max-width: 760px) 54vw, 26vw"
        alt="Figos cristalizados no açúcar, num prato branco"
        loading="eager"
      />
      <Image
        class="recorte recorte--sortida"
        src={sortida}
        widths={larguras}
        quality={qualidade}
        sizes="(max-width: 760px) 46vw, 22vw"
        alt="Bandeja sortida com doce de abóbora, de batata, doce de leite e bananada"
        loading="eager"
        fetchpriority="high"
      />
      <div class="selo" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><path id="selo-roda" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
          <circle cx="60" cy="60" r="58" fill="#f2c14e" />
          <circle cx="60" cy="60" r="53" fill="none" stroke="#2b1a12" stroke-opacity="0.25" />
          <text><textPath href="#selo-roda" textLength="274" lengthAdjust="spacingAndGlyphs">DESDE 1985 · PIQUETE-SP · DOCES CASEIROS ·</textPath></text>
          <path d="M36 76 50 54l6 8 11-20 17 34z" fill="#c10413" />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: max(100svh, 44rem);
    padding: calc(var(--altura-cabecalho) + 2rem) var(--margem) 5.5rem;
    overflow: hidden;
    background: var(--fundo-vermelho);
    color: var(--creme);
  }

  /* A serra sombreada fica atrás de tudo e some para baixo, no vermelho. */
  .hero__serra {
    position: absolute;
    inset: 4rem 0 auto;
    width: 100%;
    height: 72%;
    object-fit: cover;
    object-position: center bottom;
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    pointer-events: none;
  }

  .hero__grade {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 2rem clamp(1rem, 3vw, 3rem);
    width: min(100%, var(--largura));
    margin-inline: auto;
  }

  .hero__texto {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .hero__titulo {
    font-size: var(--t-gigante);
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-shadow: 0 6px 30px rgb(40 0 4 / 0.45);
  }

  .hero__titulo span {
    display: block;
  }

  .hero :global(.hero__filete) {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }

  .hero__apoio {
    max-width: 26ch;
    margin-top: 1rem;
    font: 400 clamp(1.25rem, 2.1vw, 1.875rem) / 1.3 var(--titulo);
    font-variation-settings: 'opsz' 36, 'SOFT' 0;
  }

  .hero__acoes {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero__revenda {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 3rem;
    padding-inline: 0.5rem;
    font-weight: 500;
    text-decoration: none;
  }

  .hero__revenda:hover {
    text-decoration: underline;
    text-decoration-color: var(--mel);
  }

  .hero__revenda svg {
    width: 0.9em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* As três fotos em grupo, como numa mesa: tigela atrás à esquerda, figo atrás à direita,
     bandeja na frente. Cada uma balança no seu tempo. */
  .hero__palco {
    position: relative;
    aspect-ratio: 1.15;
  }

  .hero :global(.recorte) {
    position: absolute;
    filter: drop-shadow(0 22px 26px rgb(40 0 4 / 0.55));
    animation: flutua 7s ease-in-out infinite alternate;
  }

  .hero :global(.recorte--pacoca) {
    --giro: -4deg;
    width: 47%;
    top: 20%;
    left: -2%;
    z-index: 1;
    animation-delay: -2s;
  }

  .hero :global(.recorte--figo) {
    --giro: 6deg;
    width: 52%;
    top: 6%;
    right: -6%;
    z-index: 1;
  }

  .hero :global(.recorte--sortida) {
    --giro: 3deg;
    width: 44%;
    top: 47%;
    left: 36%;
    z-index: 2;
    animation-delay: -4s;
  }

  @keyframes flutua {
    from {
      transform: translateY(0) rotate(var(--giro));
    }
    to {
      transform: translateY(-14px) rotate(calc(var(--giro) * -0.4));
    }
  }

  .selo {
    position: absolute;
    z-index: 3;
    top: -2%;
    left: 40%;
    width: clamp(88px, 10vw, 150px);
  }

  .selo svg {
    animation: gira 24s linear infinite;
  }

  .selo text {
    fill: var(--cafe);
    font: 700 10.5px var(--texto);
    letter-spacing: 0.14em;
  }

  @keyframes gira {
    to {
      transform: rotate(1turn);
    }
  }

  @media (max-width: 900px) {
    .hero {
      display: block;
      min-height: auto;
      padding: calc(var(--altura-cabecalho) + 1.5rem) 1rem 2.5rem;
    }

    .hero__serra {
      inset: 3rem 0 auto;
      height: 22rem;
    }

    .hero__grade {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* No celular: título em cima, fotos no meio, botões embaixo (sem rolar em 360×740). */
    .hero__texto {
      display: contents;
    }

    .hero__titulo,
    .hero :global(.hero__filete),
    .hero__apoio {
      justify-self: center;
      text-align: center;
    }

    .hero__titulo {
      order: 1;
      font-size: 14.5vw;
    }

    .hero :global(.hero__filete) {
      order: 2;
      margin-top: 1rem;
      width: 78%;
    }

    .hero__apoio {
      order: 3;
      margin-top: 0.6rem;
      font-size: 1.1875rem;
    }

    .hero__palco {
      order: 4;
      width: calc(100% + 2rem);
      max-width: 34rem;
      margin: 0.5rem -1rem 0;
      justify-self: center;
      aspect-ratio: 1.7;
    }

    .hero :global(.recorte--pacoca) {
      width: 43%;
      top: 16%;
    }

    .hero :global(.recorte--figo) {
      width: 47%;
      top: 2%;
    }

    .hero :global(.recorte--sortida) {
      width: 38%;
      top: 34%;
      left: 37%;
    }

    .selo {
      top: -6%;
      width: 76px;
    }

    .hero__acoes {
      order: 5;
      margin-top: 0.75rem;
      gap: 0.25rem;
    }

    .hero__acoes > :global(.botao) {
      width: 100%;
      padding-inline: 1rem;
      font-size: 1rem;
    }
  }
</style>
