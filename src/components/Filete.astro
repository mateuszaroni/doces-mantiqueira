---
interface Props {
  /** "claro" sobre o vermelho/tacho; "escuro" sobre o creme. */
  tom?: 'claro' | 'escuro';
  class?: string;
}

const { tom = 'claro', class: classe } = Astro.props;
---

<!-- Dois filetes dourados com a montanhinha da logo no meio: o ornamento do conceito v3. -->
<div class:list={['filete', `filete--${tom}`, classe]} aria-hidden="true">
  <span></span>
  <svg viewBox="0 0 48 24">
    <path d="M2 22 15 6l6 7 6-9 19 18" />
    <path d="M11 11l4-5 3 3.5M24 7.5l3-3.5 4 4.5" />
  </svg>
  <span></span>
</div>

<style>
  .filete {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, 26rem);
  }

  .filete span {
    flex: 1;
    height: 1px;
  }

  .filete svg {
    width: 3rem;
    flex: none;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .filete--claro span {
    background: var(--dourado);
  }

  .filete--claro svg {
    stroke: var(--creme);
  }

  .filete--escuro span {
    background: rgb(138 90 31 / 0.55);
  }

  .filete--escuro svg {
    stroke: var(--caramelo);
  }
</style>
