---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import Filete from './Filete.astro';
import { mensagens } from '../config';
import lista from '../data/doces.json';

// A coleção não garante a ordem: a vitrine segue a ordem do arquivo (a do briefing).
const ordem = lista.map((d) => d.id);
const doces = (await getCollection('doces')).sort((a, b) => ordem.indexOf(a.id) - ordem.indexOf(b.id));
---

<section class="produtos" id="produtos" aria-labelledby="produtos-titulo">
  <div class="envelope produtos__cabeca">
    <div>
      <h2 class="titulo-secao" id="produtos-titulo">Conheça nossos produtos</h2>
      <Filete tom="escuro" class="filete-secao" />
    </div>
    <p>
      Escolha o doce e peça pelo WhatsApp: a mensagem já vai com o nome dele. Todos vêm no pacote de 350g, e o preço você
      combina na conversa.
    </p>
  </div>

  <p class="produtos__dica" id="produtos-dica">
    Deslize para ver os 9 doces
    <span class="produtos__posicao" aria-hidden="true"><span data-posicao>1</span> de {doces.length}</span>
  </p>
  <ul class="produtos__lista" tabindex="0" aria-label="Os 9 doces" aria-describedby="produtos-dica">
    {
      doces.map(({ data }, i) => (
        <li
          class:list={['doce', { 'doce--sangra': data.sangra, 'doce--destaque': i === 0 }]}
          style={`--fundo: ${data.fundo}; --giro: ${i % 2 ? 3 : -3}deg`}
        >
          <div class="doce__foto">
            <Image
              src={data.recorte}
              widths={[320, 480, 640, 900]}
              sizes={i === 0 ? '(max-width: 760px) 80vw, (max-width: 1100px) 90vw, 820px' : '(max-width: 760px) 80vw, (max-width: 1100px) 45vw, 400px'}
              quality={72}
              alt={data.alt}
            />
          </div>
          <div class="doce__texto">
            <h3>{data.nome}</h3>
            <p>{data.descricao}</p>
          </div>
          <BotaoWhatsApp
            class="doce__botao"
            variante="contorno"
            mensagem={mensagens.produto(data.artigo, data.nome.toLowerCase())}
            rotulo="Pedir no WhatsApp"
            complementoLeitor={data.nome}
          />
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Carrossel do celular: mostra em qual dos 9 doces a pessoa está ("3 de 9").
  const lista = document.querySelector('.produtos__lista');
  const posicao = document.querySelector('[data-posicao]');
  if (lista && posicao && 'IntersectionObserver' in window) {
    const cards = [...lista.children];
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) posicao.textContent = String(cards.indexOf(e.target) + 1);
        }
      },
      { root: lista, threshold: 0.6 },
    );
    cards.forEach((card) => observador.observe(card));
  }
</script>

<style>
  .produtos {
    padding-block: var(--respiro);
  }

  .produtos__cabeca {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
  }

  .produtos__cabeca p {
    max-width: 38ch;
    justify-self: end;
    font-size: var(--t-grande);
  }

  .produtos__dica {
    display: none;
  }

  .produtos__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
    width: min(100% - 2 * var(--margem), var(--largura));
    margin: clamp(2.5rem, 5vw, 4.5rem) auto 0;
    padding: 0;
    list-style: none;
  }

  .doce {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 2rem;
    background: var(--fundo);
  }

  .doce__foto {
    display: flex;
    justify-content: center;
    height: clamp(15rem, 22vw, 19rem);
    padding: 1.75rem 1.5rem 0.5rem;
  }

  .doce__foto img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 16px 18px rgb(43 26 18 / 0.25));
    transform: rotate(var(--giro));
  }

  /* Prato cortado no enquadramento da foto: o recorte passa das bordas do card e o lado reto some. */
  .doce--sangra .doce__foto {
    padding-inline: 0;
  }

  .doce--sangra .doce__foto img {
    transform: scale(1.22);
  }

  .doce__texto {
    flex: 1;
    padding: 1rem 1.75rem 0;
  }

  .doce h3 {
    font-size: var(--t-card);
  }

  .doce__texto p {
    margin-top: 0.6rem;
  }

  /* Botão de contorno: nove botões cheios virariam uma parede vermelha. */
  .doce :global(.doce__botao) {
    margin: 1.5rem 1rem 1rem;
    padding-inline: 1rem;
    border-color: var(--tacho);
    color: var(--tacho);
  }

  .doce :global(.doce__botao:hover) {
    border-color: var(--vermelho);
    background: var(--vermelho);
    color: #fff;
  }

  /* O primeiro doce abre o cardápio em destaque: ocupa 2 colunas e 2 linhas. */
  .doce--destaque {
    grid-column: span 2;
    grid-row: span 2;
  }

  .doce--destaque .doce__foto {
    flex: 1;
    height: auto;
    min-height: clamp(20rem, 30vw, 26rem);
    padding: 3rem clamp(3rem, 8vw, 7rem) 0.5rem;
  }

  .doce--destaque .doce__texto {
    flex: none;
    padding-inline: 2.5rem;
  }

  .doce--destaque h3 {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
  }

  .doce--destaque .doce__texto p {
    font-size: var(--t-grande);
  }

  .doce--destaque :global(.doce__botao) {
    align-self: flex-start;
    margin: 1.75rem 2.5rem 2rem;
    padding-inline: 1.6rem;
  }

  @media (max-width: 1100px) {
    .produtos__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doce--destaque {
      grid-row: auto;
    }

    .doce--destaque .doce__foto {
      min-height: 24rem;
    }
  }

  /* No celular, carrossel com rolagem lateral: o próximo card aparece pela metade. */
  @media (max-width: 760px) {
    .produtos__cabeca {
      grid-template-columns: 1fr;
    }

    .produtos__cabeca p {
      justify-self: start;
    }

    .produtos__dica {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      width: min(100% - 2 * var(--margem), var(--largura));
      margin: 2rem auto 0;
      color: var(--caramelo);
      font-weight: 600;
    }

    .produtos__posicao {
      color: var(--cafe);
      font-variant-numeric: tabular-nums;
    }

    .produtos__lista {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 0.875rem;
      width: auto;
      margin-top: 1rem;
      padding: 0 var(--margem) 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      /* Sem isto o Chrome no celular alarga a página até o fim do carrossel. */
      contain: paint;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--margem);
      scrollbar-width: none;
    }

    .produtos__lista::-webkit-scrollbar {
      display: none;
    }

    .doce {
      scroll-snap-align: start;
    }

    .doce--destaque {
      grid-column: auto;
    }

    .doce__foto,
    .doce--destaque .doce__foto {
      flex: none;
      height: 14rem;
      min-height: 0;
      padding: 1.75rem 1.5rem 0.5rem;
    }

    .doce--destaque .doce__texto {
      padding-inline: 1.75rem;
    }

    .doce--destaque h3 {
      font-size: var(--t-card);
    }

    .doce--destaque .doce__texto p {
      font-size: inherit;
    }

    .doce--destaque :global(.doce__botao) {
      align-self: stretch;
      margin: 1.5rem 1rem 1rem;
      padding-inline: 1rem;
    }
  }
</style>
