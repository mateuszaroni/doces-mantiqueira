---
import { Picture } from 'astro:assets';
import { negocio } from '../config';
import { recorteSerra } from '../lib/serra';
import avos from '../assets/fotos/historia/avos-pedro-e-mariazinha.png';
---

<section class="historia" id="historia" aria-labelledby="titulo-historia">
  <div class="historia__painel">
    <h2 id="titulo-historia" class="historia__titulo entra">Desde 1985, no pé da Serra da Mantiqueira</h2>

    <div class="historia__texto">
      <p class="entra" style="--ordem: 1">
        Tudo começou com Seu Pedro Sabão e Dona Mariazinha, fazendo balas de café em Piquete. Em 1987, Seu Pedro
        aprendeu com um doceiro de Guaratinguetá as receitas que viraram a cara da casa: doce de leite, de abóbora, de
        batata-doce e paçoca.
      </p>
      <p class="entra" style="--ordem: 2">
        Nos anos 90, a segunda geração assumiu o tacho — e o jeito de fazer continua o mesmo. O doce de abóbora e o de
        batata levam até quatro dias para ficar prontos.
      </p>
      <p class="entra" style="--ordem: 3">
        Hoje são mais de 40 anos adoçando festas, quermesses e mesas de todo o Vale do Paraíba até Resende.
      </p>

      <ul class="selos entra" style="--ordem: 4" role="list">
        <li class="selo">
          <span class="selo__linha">Integra a</span>
          <strong class="selo__titulo">Rota Gastronômica do Vale do Paraíba &amp; Mantiqueira</strong>
          <span class="selo__linha">Secretaria de Turismo de SP</span>
        </li>
        <li>
          <a class="selo selo--link" href={negocio.reportagemG1} target="_blank" rel="noopener">
            <strong class="selo__titulo">Saiu no g1</strong>
            <span class="selo__linha">Ler a reportagem<span class="so-leitor">{', abre em nova aba'}</span></span>
          </a>
        </li>
      </ul>
    </div>

    <Picture
      src={avos}
      alt="Seu Pedro Sabão e Dona Mariazinha, fundadores da Doces Mantiqueira"
      formats={['avif', 'webp']}
      widths={[360, 540, 720, 984]}
      sizes="(min-width: 56rem) 40vw, 86vw"
      loading="lazy"
      pictureAttributes={{ class: 'historia__foto entra', style: '--ordem: 2' }}
      style={`clip-path: ${recorteSerra(12)}`}
    />
  </div>
</section>

<style>
  /* Painel cor de tacho, recuado das bordas da tela. */
  .historia {
    padding-inline: 0.75rem;
  }

  .historia__painel {
    display: grid;
    gap: 1.75rem;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--margem) 0;
    overflow: hidden;
    border-radius: var(--raio);
    background: var(--tacho);
    color: var(--creme);
  }

  .historia__titulo {
    max-width: 14ch;
    font-size: var(--texto-secao);
  }

  .historia__texto p + p {
    margin-top: 1rem;
  }

  .historia__texto p {
    max-width: 52ch;
  }

  /* A foto encosta no pé do painel, que corta a parte de baixo. */
  .historia__foto {
    justify-self: center;
    width: min(100%, 30rem);
    margin-bottom: -12%;
  }

  .historia__foto :global(img) {
    width: 100%;
  }

  /* Selos tipográficos: filete duplo, como a faixa da logo. */
  .selos {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .selo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    max-width: 17rem;
    min-height: 100%;
    padding: 0.85rem 1.1rem;
    border: 2px solid var(--prato);
    outline: 1px solid var(--prato);
    outline-offset: -6px;
    border-radius: 0.25rem;
    color: var(--creme);
    line-height: 1.3;
  }

  .selo__titulo {
    font-family: var(--fonte-titulo);
    font-weight: 400;
    font-size: 1.125rem;
    color: var(--prato);
  }

  .selo__linha {
    font-size: 0.875rem;
  }

  .selo--link {
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .selo--link .selo__linha {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .selo--link:hover {
    background: rgb(242 182 50 / 0.14);
  }

  .selo--link:focus-visible {
    outline: 3px solid var(--creme);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .selo--link {
      transition: none;
    }
  }

  @media (min-width: 56rem) {
    .historia__painel {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 6vw, 6rem);
      row-gap: 2.5rem;
      padding-top: clamp(4rem, 7vw, 6rem);
    }

    .historia__titulo {
      grid-column: 1;
      grid-row: 1;
    }

    .historia__foto {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
      justify-self: start;
      width: min(100%, 34rem);
    }

    .historia__texto {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
      padding-bottom: clamp(4rem, 7vw, 6rem);
    }
  }
</style>
