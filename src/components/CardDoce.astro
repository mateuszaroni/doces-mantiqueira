---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import { mensagens } from '../config';
import { recorteSerra } from '../lib/serra';

interface Props {
  id: string;
  doce: CollectionEntry<'doces'>['data'];
  /** Cor do "céu" atrás da serra, um token de cor. */
  campo: string;
}

const { id, doce, campo } = Astro.props;
// "Doce de leite" vira "doce de leite" no meio da frase da mensagem.
const nomeNaFrase = doce.nome.charAt(0).toLowerCase() + doce.nome.slice(1);
---

<li class="painel" style={`--campo: var(${campo})`}>
  <div class="painel__palco" data-doce={id}>
    <Picture
      src={doce.foto}
      alt={doce.alt}
      formats={['avif', 'webp']}
      width={800}
      height={1000}
      fit="cover"
      widths={[400, 600, 800]}
      sizes="(min-width: 56rem) 38vw, 92vw"
      loading="lazy"
      style={`clip-path: ${recorteSerra(14)}`}
    />
  </div>
  <div class="painel__texto" data-doce={id}>
    <h3>{doce.nome}</h3>
    <p>{doce.descricao}</p>
    <BotaoWhatsApp
      variante="compacto"
      mensagem={mensagens.produto(doce.artigo, nomeNaFrase)}
      rotulo="Pedir este"
      detalhe=""
      complementoLeitor={doce.nome}
    />
  </div>
</li>
