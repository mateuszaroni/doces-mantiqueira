---
import { Picture } from 'astro:assets';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import { mensagens } from '../config';
import { recorteSerra } from '../lib/serra';
import pacote from '../assets/fotos/extras/pacoca-pacote-350g.jpg';

// Só os argumentos aprovados no briefing: sem números de margem, sem pedido mínimo, sem formatos de atacado.
const argumentos = [
  {
    titulo: 'Ótima margem de revenda',
    texto: 'O preço para revenda você combina direto com o Felipe.',
  },
  {
    titulo: 'Validade de 45 dias',
    texto: 'Prazo bom para a prateleira da padaria, do empório ou do mercado.',
  },
  {
    titulo: 'Entrega em todo o Vale do Paraíba',
    texto: 'De Piquete até Resende (RJ).',
  },
  {
    titulo: 'Mais de 40 anos de tradição',
    texto: 'Doce artesanal, feito pela mesma família desde 1985.',
  },
];
// Cada marcador (um pico da serra) leva uma cor dos pratos das fotos.
const cores = ['--vermelho', '--abobora', '--prato', '--tacho'];
---

<section class="revenda" id="revenda" aria-labelledby="titulo-revenda">
  <div class="revenda__grade">
    <Picture
      src={pacote}
      alt="Pacote de paçoca de amendoim Doces Mantiqueira de 350g, com rótulo, sobre prato laranja"
      formats={['avif', 'webp']}
      widths={[400, 600, 800, 1080]}
      sizes="(min-width: 56rem) 42vw, 92vw"
      loading="lazy"
      pictureAttributes={{ class: 'revenda__foto entra' }}
      style={`clip-path: ${recorteSerra(12)}`}
    />

    <div class="revenda__texto">
      <h2 id="titulo-revenda" class="entra">Revenda os Doces Mantiqueira</h2>
      <p class="revenda__publico entra" style="--ordem: 1">
        Para padarias, empórios, mercados e para quem quer uma renda extra.
      </p>

      <ul class="revenda__lista" role="list">
        {
          argumentos.map((a, i) => (
            <li class="entra" style={`--ordem: ${i + 1}; --pico: var(${cores[i]})`}>
              <h3>{a.titulo}</h3>
              <p>{a.texto}</p>
            </li>
          ))
        }
      </ul>

      <BotaoWhatsApp
        class="revenda__botao entra"
        mensagem={mensagens.revenda}
        rotulo="Quero revender — falar com o Felipe"
        detalhe="Pelo WhatsApp"
      />
    </div>
  </div>
</section>

<style>
  .revenda {
    padding-block: var(--entre-secoes);
    overflow: hidden;
  }

  .revenda__grade {
    display: grid;
    gap: 2.5rem;
    max-width: var(--largura);
    margin-inline: auto;
    padding-inline: var(--margem);
  }

  /* A foto sai pela borda esquerda da tela, com o topo em serra. */
  .revenda__foto {
    width: 88%;
    margin-left: calc(var(--margem) * -1);
  }

  .revenda__foto :global(img) {
    width: 100%;
    max-height: 62svh;
    object-fit: cover;
    border-radius: 0 var(--raio) var(--raio) 0;
  }

  h2 {
    max-width: 17ch;
    font-size: var(--texto-secao);
  }

  .revenda__publico {
    margin-top: 1rem;
    max-width: 34ch;
    color: var(--madeira);
  }

  .revenda__lista {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .revenda__lista li {
    position: relative;
    padding-left: 1.5rem;
  }

  /* Marcador: um pico da serra na cor do ponto. */
  .revenda__lista li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 0.95rem;
    height: 0.7rem;
    background: var(--pico);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  h3 {
    font-size: 1.25rem;
  }

  .revenda__lista p {
    margin-top: 0.25rem;
    color: var(--madeira);
    font-size: var(--texto-p);
  }

  .revenda__texto :global(.revenda__botao) {
    margin-top: 2.25rem;
  }

  @media (min-width: 40rem) {
    .revenda__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 56rem) {
    .revenda__grade {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      column-gap: clamp(3rem, 6vw, 6rem);
    }

    .revenda__foto {
      width: calc(100% + var(--margem) + 4vw);
      margin-left: calc((var(--margem) + 4vw) * -1);
    }

    .revenda__foto :global(img) {
      max-height: 82svh;
    }
  }
</style>
