---
import { Picture } from 'astro:assets';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import { mensagens } from '../config';
import pratoFesta from '../assets/fotos/produtos/doce-de-leite-e-cajuzinho-prato.jpg';
import cajuzinho from '../assets/fotos/extras/cajuzinho-na-mao.jpg';
import sortida from '../assets/fotos/produtos/sortida-prato.jpg';
import abobora from '../assets/fotos/extras/abobora-cortada.jpg';
import panelinha from '../assets/fotos/extras/doce-de-leite-panelinha.jpg';

// Mural de ladrilhos: as ocasiões da festa em letra grande, intercaladas com fotos e a toalha.
type Ladrilho =
  | { tipo: 'palavra'; texto: string; legenda?: string; cor: string; tinta: string }
  | { tipo: 'foto'; src: ImageMetadata; alt: string }
  | { tipo: 'toalha' };

const ladrilhos: Ladrilho[] = [
  { tipo: 'palavra', texto: 'Festa junina', cor: '--vermelho', tinta: '--creme' },
  { tipo: 'foto', src: pratoFesta, alt: 'Prato com tabletes de doce de leite e cajuzinhos, sobre toalha xadrez vermelha' },
  { tipo: 'palavra', texto: 'Quermesse', legenda: 'de paróquia', cor: '--prato', tinta: '--tacho' },
  { tipo: 'toalha' },
  { tipo: 'foto', src: cajuzinho, alt: 'Mão segurando um cajuzinho passado no açúcar' },
  { tipo: 'palavra', texto: 'Arraiá', cor: '--abobora', tinta: '--tacho' },
  { tipo: 'foto', src: sortida, alt: 'Prato com doce de abóbora, de batata, doce de leite e bananada em cubinhos' },
  { tipo: 'palavra', texto: 'Aniversário', legenda: 'caipira', cor: '--tacho', tinta: '--creme' },
  { tipo: 'palavra', texto: 'Junho', legenda: 'época mais procurada', cor: '--creme-rotulo', tinta: '--tacho' },
  { tipo: 'foto', src: abobora, alt: 'Pedaços de doce de abóbora cortados, mostrando o miolo' },
  { tipo: 'palavra', texto: 'Julho', legenda: 'peça com antecedência', cor: '--vermelho', tinta: '--creme' },
  { tipo: 'foto', src: panelinha, alt: 'Tabletes de doce de leite numa panelinha vermelha' },
];
---

<section class="festas" id="festas" aria-labelledby="titulo-festas">
  <div class="envelope festas__cabeca">
    <h2 id="titulo-festas" class="entra">Festas, quermesses e arraiás</h2>
    <div class="festas__texto">
      <p class="entra" style="--ordem: 1">
        Para quem monta mesa de festa, quermesse de paróquia, arraiá ou aniversário caipira. A bandeja sortida traz um
        pouco de cada, e os outros doces da vitrine completam a mesa.
      </p>
      <p class="entra" style="--ordem: 2">Junho e julho são a época mais procurada. Vale pedir com antecedência.</p>
      <BotaoWhatsApp
        class="festas__botao entra"
        mensagem={mensagens.festas}
        rotulo="Pedir orçamento para festa"
      />
    </div>
  </div>

  <ul class="mural" role="list">
    {
      ladrilhos.map((l, i) => (
        <li class={`ladrilho ladrilho--${l.tipo} entra`} style={`--ordem: ${i % 4}`}>
          {l.tipo === 'palavra' && (
            <div class="ladrilho__palavra" style={`--fundo: var(${l.cor}); --tinta: var(${l.tinta})`}>
              <span class="ladrilho__texto">{l.texto}</span>
              {l.legenda && <span class="ladrilho__legenda">{l.legenda}</span>}
            </div>
          )}
          {l.tipo === 'foto' && (
            <Picture
              src={l.src}
              alt={l.alt}
              formats={['avif', 'webp']}
              width={600}
              height={600}
              fit="cover"
              widths={[300, 450, 600]}
              sizes="(min-width: 48rem) 25vw, 50vw"
              loading="lazy"
            />
          )}
          {l.tipo === 'toalha' && <div class="ladrilho__toalha xadrez" aria-hidden="true" />}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .festas {
    padding-block: var(--entre-secoes) 0.5rem;
  }

  .festas__cabeca {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  h2 {
    max-width: 17ch;
    font-size: var(--texto-secao);
  }

  .festas__texto p + p {
    margin-top: 0.75rem;
  }

  .festas__texto p {
    max-width: 46ch;
  }

  .festas__texto :global(.festas__botao) {
    margin-top: 1.5rem;
  }

  /* Mural: ladrilhos quadrados de ponta a ponta, com juntas de 8px. */
  .mural {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
    margin: 0;
    padding: 0 0.375rem;
    list-style: none;
  }

  .ladrilho {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.25rem;
  }

  .ladrilho :global(picture),
  .ladrilho :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ladrilho__palavra {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    padding: 0.75rem;
    background: var(--fundo);
    color: var(--tinta);
    text-align: center;
  }

  .ladrilho__texto {
    font-family: var(--fonte-titulo);
    font-size: clamp(1.35rem, 6vw, 3.25rem);
    line-height: 1;
    text-wrap: balance;
  }

  .ladrilho__legenda {
    position: absolute;
    bottom: 1rem;
    left: 0.5rem;
    right: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .ladrilho__toalha {
    height: 100%;
    background-size: 2rem 2rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ladrilho :global(img),
    .ladrilho__palavra {
      transition: transform 0.6s var(--curva);
    }

    .ladrilho:hover :global(img) {
      transform: scale(1.05);
    }

    .ladrilho:hover .ladrilho__palavra {
      transform: scale(0.97);
    }
  }

  @media (min-width: 56rem) {
    .festas__cabeca {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: 4rem;
    }
  }

  @media (min-width: 48rem) {
    .mural {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.5rem;
      padding-inline: 0.5rem;
    }

    .ladrilho__texto {
      font-size: clamp(1.35rem, 3vw, 3.25rem);
    }

    .ladrilho__legenda {
      bottom: 1.25rem;
    }
  }
</style>
