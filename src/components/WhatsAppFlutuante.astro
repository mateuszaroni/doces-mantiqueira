---
import { siWhatsapp } from 'simple-icons';
import { linkWhatsApp, mensagens } from '../config';
---

<a class="flutuante" href={linkWhatsApp(mensagens.flutuante)} target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
  <span class="flutuante__texto">Fale com o Felipe</span>
  <span class="so-leitor">{' no WhatsApp, abre em nova aba'}</span>
</a>

<style>
  /* Fixo no canto, só o ícone no celular para não cobrir o conteúdo. */
  .flutuante {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: var(--vermelho);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 0.25rem 0.75rem rgb(58 36 23 / 0.35); /* taste-skill-ignore: botão que flutua sobre a página */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.15s;
  }

  .flutuante:hover,
  .flutuante:active {
    background: var(--vermelho-escuro);
  }

  .flutuante:focus-visible {
    outline-color: var(--tacho);
  }

  svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: currentColor;
  }

  /* No celular o texto some da tela, mas continua sendo o nome lido pelo leitor de tela. */
  .flutuante__texto {
    position: absolute;
    width: 1px;
    height: 1px; /* taste-skill-ignore: texto só para leitor de tela */
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 64rem) {
    .flutuante {
      width: auto;
      padding: 0 1.4rem 0 1.1rem;
      right: 1.5rem;
      bottom: 1.5rem;
    }

    svg {
      width: 1.5rem;
      height: 1.5rem;
    }

    .flutuante__texto {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flutuante {
      transition: none;
    }
  }
</style>
