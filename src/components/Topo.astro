---
import { Image, Picture } from 'astro:assets';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import { mensagens } from '../config';
import logo from '../assets/logo/logo.svg';
import doceDeLeite from '../assets/fotos/extras/doce-de-leite-na-mao.jpg';
import batataRoxa from '../assets/fotos/extras/batata-roxa-partida.jpg';
import figo from '../assets/fotos/produtos/figo-cortado.jpg';
import batata from '../assets/fotos/extras/batata-partida-na-mao.jpg';

// O movimento-assinatura: a foto grande troca devagar entre doces na mão.
const fotos = [
  { src: doceDeLeite, alt: 'Mão segurando dois tabletes de doce de leite' },
  { src: batataRoxa, alt: 'Mão segurando um doce de batata-doce roxa partido ao meio' },
  { src: figo, alt: 'Figo cristalizado cortado ao meio, na palma da mão' },
  { src: batata, alt: 'Mão segurando um doce de batata-doce branca partido ao meio' },
];

const links = [
  { href: '#doces', texto: 'Os doces' },
  { href: '#festas', texto: 'Festas' },
  { href: '#revenda', texto: 'Revenda' },
  { href: '#onde-estamos', texto: 'Onde estamos' },
];
---

<section class="topo" aria-labelledby="titulo-topo">
  <div class="topo__foto">
    {
      fotos.map((f, i) => (
        <Picture
          src={f.src}
          alt={f.alt}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1080]}
          sizes="(min-width: 56rem) 50vw, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'low'}
          pictureAttributes={{ class: 'topo__slide', style: `--i: ${i}` }}
        />
      ))
    }
  </div>

  <div class="topo__cartao">
    <div class="topo__toalha xadrez" aria-hidden="true"></div>
    <div class="topo__corpo">
      <a href="/" class="topo__logo surge" style="--ordem: 0" translate="no">
        <Image src={logo} alt="Doces Mantiqueira, Piquete (SP)" width={260} loading="eager" />
      </a>
      <h1 id="titulo-topo" class="surge" style="--ordem: 1">
        Doces caseiros da Serra da Mantiqueira, desde 1985
      </h1>
      <p class="topo__sub surge" style="--ordem: 2">
        Paçoca, cajuzinho, doce de leite, de abóbora e de batata, feitos de forma artesanal em Piquete (SP), do
        jeito que a família faz há mais de 40 anos.
      </p>
      <div class="topo__acoes surge" style="--ordem: 3">
        <BotaoWhatsApp mensagem={mensagens.varejo} rotulo="Pedir / orçamento para festa" />
        <a class="botao botao--secundario" href="#revenda">Quero revender</a>
      </div>
    </div>
    <nav class="topo__nav surge" style="--ordem: 4" aria-label="Seções do site">
      {links.map((l) => <a href={l.href}>{l.texto}</a>)}
    </nav>
  </div>
</section>

<style>
  .topo {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem;
  }

  /* Foto: as quatro ficam empilhadas e trocam por opacidade. */
  .topo__foto {
    position: relative;
    display: grid;
    height: 26svh;
    min-height: 12rem;
    overflow: hidden;
    border-radius: var(--raio);
    background: var(--creme-rotulo);
  }

  .topo__foto :global(.topo__slide) {
    grid-area: 1 / 1;
  }

  .topo__foto :global(.topo__slide:not(:first-child)) {
    opacity: 0;
  }

  .topo__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .topo__foto :global(.topo__slide) {
      animation: troca 24s linear infinite;
      animation-delay: calc(var(--i) * 6s - 1.5s);
    }
  }

  @keyframes troca {
    0% {
      opacity: 0;
      transform: scale(1.06);
    }
    6.5% {
      opacity: 1;
    }
    25% {
      opacity: 1;
    }
    31.5% {
      opacity: 0;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  /* Cartão: um rótulo impresso, com a toalha xadrez no alto. */
  .topo__cartao {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    margin-top: -1.5rem;
    overflow: hidden;
    border-radius: var(--raio);
    background: var(--creme-rotulo);
    text-align: center;
  }

  .topo__toalha {
    height: 2.25rem;
  }

  .topo__corpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.25rem 1.5rem;
  }

  .topo__logo img {
    width: clamp(8rem, 36vw, 16.25rem);
  }

  h1 {
    margin-top: 0.75rem;
    max-width: 21ch;
    font-size: var(--texto-h1);
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  .topo__sub {
    margin-top: 0.75rem;
    max-width: 38ch;
    color: var(--madeira);
  }

  .topo__acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .topo__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    padding: 0 1rem 1.25rem;
    font-size: var(--texto-p);
  }

  .topo__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--tacho);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .topo__nav a:hover {
    color: var(--vermelho);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 56rem) {
    .topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      min-height: 100svh;
    }

    .topo__foto {
      order: 2;
      height: auto;
      min-height: 36rem;
    }

    .topo__foto :global(img) {
      object-position: 50% 45%;
    }

    .topo__cartao {
      margin-top: 0;
    }

    .topo__toalha {
      height: 3.5rem;
    }

    .topo__corpo {
      padding: 2.5rem 2.5rem 2rem;
    }

    h1 {
      margin-top: 1.75rem;
    }

    .topo__sub {
      margin-top: 1rem;
    }

    .topo__acoes {
      margin-top: 1.75rem;
    }

    .topo__nav {
      padding-bottom: 1.75rem;
    }
  }
</style>
