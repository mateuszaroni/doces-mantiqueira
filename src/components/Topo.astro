---
import { Picture } from 'astro:assets';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import { mensagens } from '../config';
import sortidaPrato from '../assets/fotos/produtos/sortida-prato.jpg';
import figoCortado from '../assets/fotos/produtos/figo-cortado.jpg';
import pacoca from '../assets/fotos/produtos/pacoca.jpg';

const formatos = ['avif', 'webp'] as const;
---

<section class="topo envelope" aria-labelledby="titulo-topo">
  <div class="topo__texto">
    <h1 id="titulo-topo">Doces caseiros da Serra da Mantiqueira, desde 1985</h1>
    <p class="topo__sub">
      Paçoca, cajuzinho, doce de leite, de abóbora e de batata, feitos de forma artesanal em Piquete (SP), do
      jeito que a família faz há mais de 40 anos.
    </p>
    <div class="topo__acoes">
      <BotaoWhatsApp mensagem={mensagens.varejo} rotulo="Pedir / orçamento para festa" />
      <a class="botao botao--secundario" href="#revenda">Quero revender</a>
    </div>
  </div>

  <div class="topo__fotos">
    <Picture
      pictureAttributes={{ class: 'topo__foto topo__foto--grande' }}
      src={sortidaPrato}
      formats={formatos}
      widths={[360, 560, 760, 1035]}
      sizes="(min-width: 64rem) 370px, 64vw"
      alt="Prato com doce de abóbora, de batata, doce de leite e bananada em cubinhos, sobre toalha xadrez vermelha"
      loading="eager"
      fetchpriority="high"
    />
    <Picture
      pictureAttributes={{ class: 'topo__foto' }}
      src={figoCortado}
      formats={formatos}
      widths={[180, 280, 380, 560]}
      sizes="(min-width: 64rem) 190px, 32vw"
      alt="Figo cristalizado cortado ao meio, na palma da mão"
      loading="eager"
    />
    <Picture
      pictureAttributes={{ class: 'topo__foto' }}
      src={pacoca}
      formats={formatos}
      widths={[180, 280, 380, 560]}
      sizes="(min-width: 64rem) 190px, 32vw"
      alt="Paçoca de amendoim esfarelada numa tigela vermelha"
      loading="eager"
    />
  </div>
</section>

<style>
  .topo {
    display: grid;
    gap: 2rem;
    padding-block: 1rem 3rem;
  }

  .topo h1 {
    font-size: var(--texto-h1);
    max-width: 15ch;
  }

  .topo__sub {
    margin-top: 1rem;
    max-width: 38ch;
    color: var(--madeira);
  }

  .topo__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .topo__fotos {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 0.5rem;
  }

  .topo__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.375rem;
  }

  .topo__foto--grande {
    grid-row: span 2;
  }

  @media (min-width: 64rem) {
    .topo {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2.5rem;
      padding-block: 1.5rem 5rem;
    }

    .topo__fotos {
      gap: 0.75rem;
    }
  }
</style>
