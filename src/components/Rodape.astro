---
import { Image } from 'astro:assets';
import { siFacebook, siInstagram } from 'simple-icons';
import { negocio, enderecoCompleto } from '../config';
import logoEscura from '../assets/logo/logo-fundo-escuro.svg';

const redes = [
  { nome: 'Instagram', url: negocio.redes.instagram, icone: siInstagram.path },
  { nome: 'Facebook', url: negocio.redes.facebook, icone: siFacebook.path },
];
---

<footer class="rodape">
  <div class="envelope rodape__grade">
    <Image
      class="rodape__logo entra"
      src={logoEscura}
      alt="Doces Mantiqueira, Piquete (SP)"
      width={720}
      loading="lazy"
    />

    <ul class="rodape__redes" role="list">
      {
        redes.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={r.icone} />
              </svg>
              {r.nome}
              <span class="so-leitor">{', abre em nova aba'}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="rodape__dados">
      <p translate="no">{negocio.razaoSocial}</p>
      <p>CNPJ {negocio.cnpj}</p>
      <p>{enderecoCompleto}</p>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: var(--tacho);
    color: var(--creme);
  }

  .rodape__grade {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-block: clamp(3.5rem, 7vw, 6rem) 6rem; /* espaço para o botão flutuante não cobrir o fim */
  }

  /* A marca fecha a página em tamanho grande. */
  .rodape :global(.rodape__logo) {
    width: min(100%, 40rem);
    margin-bottom: 0.5rem;
  }

  .rodape__redes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rodape__redes a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    text-underline-offset: 0.2em;
  }

  .rodape__redes a:hover {
    text-decoration-thickness: 2px;
  }

  .rodape__redes a:focus-visible {
    outline-color: var(--creme);
  }

  .rodape__redes svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  .rodape__dados {
    font-size: var(--texto-p);
    line-height: 1.5;
    opacity: 0.9;
  }

  @media (min-width: 64rem) {
    .rodape__grade {
      grid-template-columns: 1fr auto;
      align-items: end;
      column-gap: 3rem;
      padding-block: 6rem 7rem; /* o fim fica acima do botão flutuante */
    }

    .rodape :global(.rodape__logo) {
      grid-column: 1 / -1;
    }

    .rodape__dados {
      text-align: right;
    }
  }
</style>
