---
import Filete from './Filete.astro';
import { negocio } from '../config';

const { endereco } = negocio;

// Só respostas confirmadas no briefing. Retirada na fábrica, prazo e quantidade para festa e
// validade no varejo entram aqui quando a família confirmar (docs/plano-7-passos.md, passo 4).
const perguntas = [
  { pergunta: 'Quanto custa?', resposta: 'O preço você combina direto no WhatsApp, junto com o pedido.' },
  { pergunta: 'Qual o tamanho?', resposta: 'Todos os doces vêm no pacote de 350g.' },
  {
    pergunta: 'Vocês atendem a minha cidade?',
    resposta: `${negocio.cidadesAtendidas.join(', ')} e ${negocio.cidadesAtendidasResumo}.`,
  },
  {
    pergunta: 'Onde fica a fábrica?',
    resposta: `${endereco.rua}, ${endereco.bairro}, ${endereco.cidade} - ${endereco.uf}. Aberto ${negocio.horario.texto.charAt(0).toLowerCase()}${negocio.horario.texto.slice(1)}.`,
  },
];
---

<section class="envelope antes" aria-labelledby="antes-titulo">
  <div class="antes__cabeca">
    <h2 id="antes-titulo">Antes de pedir</h2>
    <Filete tom="escuro" class="filete-secao" />
  </div>
  <dl class="antes__lista">
    {
      perguntas.map((p) => (
        <div>
          <dt>{p.pergunta}</dt>
          <dd>{p.resposta}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .antes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    /* Encosta um pouco nos produtos: é a continuação da escolha. */
    margin-top: calc(var(--respiro) * -0.4);
    margin-bottom: var(--respiro);
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .antes__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 4vw, 3.5rem);
  }

  .antes__lista div {
    padding-block: 1.25rem;
    border-top: 1.5px solid rgb(138 90 31 / 0.35);
  }

  dt {
    font: 600 1.375rem / 1.2 var(--titulo);
    font-variation-settings: 'opsz' 48, 'SOFT' 0;
  }

  dd {
    margin-top: 0.4rem;
    max-width: 44ch;
  }

  @media (max-width: 900px) {
    .antes {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .antes__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
