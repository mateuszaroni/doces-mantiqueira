---
import { siFacebook, siInstagram } from 'simple-icons';
import logo from '../assets/logo/logo-fundo-escuro.svg';
import serraFundo from '../assets/fundo/serra-fundo.svg';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import { mensagens, negocio } from '../config';

interface Props {
  /** Na 404 os links apontam para a página inicial. */
  base?: string;
}

const { base = '' } = Astro.props;

const links = [
  { href: '#produtos', rotulo: 'Produtos' },
  { href: '#historia', rotulo: 'Nossa história' },
  { href: '#festas', rotulo: 'Festas' },
  { href: '#revenda', rotulo: 'Revenda' },
  { href: '#onde-estamos', rotulo: 'Onde estamos' },
];
---

<header class="cabecalho">
  <div class="cabecalho__barra">
    <a class="cabecalho__logo" href={base || '#topo'}>
      <img src={logo.src} width="170" height="81" alt="Doces Mantiqueira, Piquete — início" />
    </a>

    <nav class="cabecalho__nav" aria-label="Seções">
      <ul>{links.map((l) => <li><a href={base + l.href}>{l.rotulo}</a></li>)}</ul>
    </nav>

    <BotaoWhatsApp class="cabecalho__cta" variante="linha" seta={false} mensagem={mensagens.geral} rotulo="Pedir no WhatsApp" />

    <button class="cabecalho__menu" type="button" popovertarget="menu" aria-label="Abrir menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
      <span aria-hidden="true">Menu</span>
    </button>
  </div>
</header>

<!-- Menu do celular: popover nativo (abre, fecha com Esc e prende o foco sem JavaScript). -->
<div id="menu" class="menu" popover style={`--serra-img: url(${serraFundo.src})`}>
  <div class="menu__topo">
    <img src={logo.src} width="120" height="57" alt="" />
    <button class="menu__fechar" type="button" popovertarget="menu" popovertargetaction="hide">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
      Fechar
    </button>
  </div>
  <nav aria-label="Seções">
    <ul class="menu__links">{links.map((l) => <li><a href={base + l.href}>{l.rotulo}</a></li>)}</ul>
  </nav>
  <div class="menu__pe">
    <BotaoWhatsApp variante="creme" mensagem={mensagens.geral} rotulo="Pedir no WhatsApp" complementoLeitor="menu" />
    <p>{negocio.horario.texto}</p>
    <ul class="menu__redes">
      <li>
        <a href={negocio.redes.instagram} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siInstagram.path} /></svg>
          Instagram
        </a>
      </li>
      <li>
        <a href={negocio.redes.facebook} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siFacebook.path} /></svg>
          Facebook
        </a>
      </li>
    </ul>
  </div>
</div>

<script>
  // Transparente sobre o hero; com fundo vinho e compacto depois de rolar um pouco.
  const cabecalho = document.querySelector('.cabecalho');
  const atualiza = () => cabecalho?.classList.toggle('cabecalho--rolou', window.scrollY > 24);
  window.addEventListener('scroll', atualiza, { passive: true });
  atualiza();

  // Ao tocar num link do menu, fecha o menu antes de rolar até a seção.
  const menu = document.getElementById('menu');
  menu?.querySelectorAll('.menu__links a').forEach((link) => {
    link.addEventListener('click', () => menu.hidePopover());
  });
</script>

<style>
  .cabecalho {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--creme);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  /* Quase opaco: translúcido, o vinho fica marrom sobre a seção mel. */
  .cabecalho--rolou {
    background: rgb(92 6 13 / 0.97);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.6);
  }

  .cabecalho__barra {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    width: min(100% - 2 * var(--margem), var(--largura));
    margin-inline: auto;
    padding-block: 1rem;
    transition: padding 0.3s;
  }

  .cabecalho--rolou .cabecalho__barra {
    padding-block: 0.5rem;
  }

  .cabecalho__logo img {
    width: 170px;
    transition: width 0.3s;
  }

  .cabecalho--rolou .cabecalho__logo img {
    width: 124px;
  }

  .cabecalho__nav {
    margin-left: auto;
  }

  .cabecalho__nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    padding: 0;
    list-style: none;
  }

  .cabecalho__nav a {
    display: inline-block;
    padding-block: 0.4rem;
    font: 400 1.125rem var(--titulo);
    font-variation-settings: 'opsz' 24, 'SOFT' 0;
    text-decoration: none;
    background: linear-gradient(var(--mel), var(--mel)) left bottom / 0 2px no-repeat;
    transition: background-size 0.25s;
  }

  .cabecalho__nav a:hover,
  .cabecalho__nav a:focus-visible {
    background-size: 100% 2px;
  }

  .cabecalho :global(.cabecalho__cta) {
    min-height: 2.875rem;
    padding: 0.5rem 1.25rem;
    font-size: 1rem;
  }

  .cabecalho__menu {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    margin-left: auto;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--creme);
    font: 500 1.125rem var(--titulo);
    cursor: pointer;
  }

  .cabecalho__menu svg {
    width: 1.625rem;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .cabecalho__menu:hover span {
    text-decoration: underline;
    text-decoration-color: var(--mel);
  }

  @media (max-width: 1020px) {
    .cabecalho__nav,
    .cabecalho :global(.cabecalho__cta) {
      display: none;
    }

    .cabecalho__menu {
      display: inline-flex;
    }
  }

  @media (max-width: 760px) {
    .cabecalho__barra {
      width: calc(100% - 2rem);
      padding-block: 0.75rem;
    }

    .cabecalho__logo img {
      width: 124px;
    }

    .cabecalho--rolou .cabecalho__logo img {
      width: 104px;
    }
  }

  /* Menu em tela cheia: o mesmo vermelho do hero, com a serra ao fundo. */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0.75rem 1rem calc(1.5rem + env(safe-area-inset-bottom));
    border: 0;
    background:
      var(--serra-img) center bottom / 160% auto no-repeat,
      var(--fundo-vermelho);
    color: var(--creme);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu:popover-open {
    display: flex;
    flex-direction: column;
  }

  .menu__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu__fechar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--creme);
    font: 500 1.125rem var(--titulo);
    cursor: pointer;
  }

  .menu__fechar svg {
    width: 1.375rem;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .menu__links {
    display: grid;
    gap: 0.25rem;
    padding: 2.5rem 0 1.5rem;
    list-style: none;
  }

  .menu__links a {
    display: block;
    padding-block: 0.25rem;
    font: 600 clamp(2.4rem, 10.5vw, 3.75rem) / 1.05 var(--titulo);
    font-variation-settings: 'opsz' 144, 'SOFT' 0;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .menu__pe {
    display: grid;
    gap: 1rem;
    margin-top: auto;
  }

  .menu__redes {
    display: flex;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .menu__redes a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    font-weight: 600;
  }

  .menu__redes svg {
    width: 1.375rem;
    fill: currentColor;
  }

  @media (min-width: 1021px) {
    .menu {
      display: none;
    }
  }
</style>
