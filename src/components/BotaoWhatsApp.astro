---
import { siWhatsapp } from 'simple-icons';
import { linkWhatsApp } from '../config';

interface Props {
  mensagem: string;
  rotulo: string;
  /** Segunda linha do botão. Passe "" para omitir. */
  detalhe?: string;
  /** Texto extra só para leitores de tela, para diferenciar botões de mesmo rótulo. */
  complementoLeitor?: string;
  variante?: 'primario' | 'secundario' | 'compacto';
  class?: string;
}

const {
  mensagem,
  rotulo,
  detalhe = 'Falar com o Felipe no WhatsApp',
  complementoLeitor,
  variante = 'primario',
  class: classe,
} = Astro.props;
---

<a
  class:list={['botao', `botao--${variante}`, classe]}
  href={linkWhatsApp(mensagem)}
  target="_blank"
  rel="noopener"
>
  <svg class="botao__icone" viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
  <span class="botao__textos">
    <span>{rotulo}{complementoLeitor && <span class="so-leitor">: {complementoLeitor}</span>}</span>
    {detalhe && <span class="botao__detalhe">{detalhe}</span>}
  </span>
  <span class="so-leitor">{", abre o WhatsApp em nova aba"}</span>
</a>
