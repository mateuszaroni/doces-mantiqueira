---
import { negocio, linkComoChegar } from '../config';

const { endereco, horario, cidadesAtendidas, cidadesAtendidasResumo } = negocio;
---

<section class="onde" id="onde-estamos" aria-labelledby="titulo-onde">
  <div class="envelope">
    <div class="cupom entra">
      <div class="cupom__lado">
        <h2 id="titulo-onde">Onde estamos</h2>
        <address>
          {endereco.rua} — {endereco.bairro}<br />
          {endereco.cidade} - {endereco.uf}, {endereco.cep}
        </address>
        <a class="botao cupom__mapa" href={linkComoChegar} target="_blank" rel="noopener">
          <svg class="botao__icone" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
            ></path>
          </svg>
          Como chegar<span class="so-leitor">{', abre o Google Maps em nova aba'}</span>
        </a>
      </div>

      <div class="cupom__picote" aria-hidden="true"></div>

      <div class="cupom__lado cupom__lado--info">
        <div>
          <h3>Horário</h3>
          <p>{horario.texto}</p>
        </div>
        <div>
          <h3>Cidades atendidas</h3>
          <p>{cidadesAtendidas.join(', ')} e {cidadesAtendidasResumo}.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .onde {
    padding-block: 0 var(--entre-secoes);
  }

  /* Cartão de rótulo para destacar: recortes nas bordas e picote no meio. */
  .cupom {
    --recorte: 1.1rem;
    display: grid;
    border-radius: var(--raio);
    background: var(--vermelho);
    color: var(--creme);
  }

  .cupom__lado {
    padding: 2rem 1.75rem;
  }

  h2 {
    font-size: var(--texto-secao);
  }

  address {
    margin-top: 1rem;
    font-style: normal;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .cupom__mapa {
    margin-top: 1.5rem;
    border-color: var(--creme);
    background: var(--creme);
    color: var(--vermelho);
  }

  .cupom__mapa:hover {
    background: var(--tacho);
    border-color: var(--tacho);
    color: var(--creme);
  }

  .cupom__mapa:focus-visible {
    outline-color: var(--creme);
  }

  /* Picote: fileira de furinhos na cor da página. */
  .cupom__picote {
    height: 0.5rem;
    margin-inline: 1.75rem;
    background: radial-gradient(circle, var(--creme) 0.22rem, transparent 0.26rem) 0 50% / 1rem 0.5rem repeat-x; /* taste-skill-ignore: furos do picote */
  }

  .cupom__lado--info {
    display: grid;
    gap: 1.5rem;
  }

  h3 {
    font-size: 1.25rem;
  }

  .cupom__lado--info p {
    margin-top: 0.35rem;
  }

  @media (min-width: 56rem) {
    .cupom {
      grid-template-columns: minmax(0, 5fr) auto minmax(0, 6fr);
      align-items: center;
      mask:
        radial-gradient(circle at 45.5% 0, transparent var(--recorte), #000 calc(var(--recorte) + 0.5px)) top / 100% 51% no-repeat,
        radial-gradient(circle at 45.5% 100%, transparent var(--recorte), #000 calc(var(--recorte) + 0.5px)) bottom / 100% 51% no-repeat; /* taste-skill-ignore: máscara dos recortes */
    }

    .cupom__lado {
      padding: clamp(3rem, 5vw, 4.5rem);
    }

    .cupom__picote {
      align-self: stretch;
      width: 0.5rem;
      height: auto;
      margin: 2rem 0;
      background: radial-gradient(circle, var(--creme) 0.22rem, transparent 0.26rem) 50% 0 / 0.5rem 1rem repeat-y; /* taste-skill-ignore: furos do picote */
    }
  }
</style>
