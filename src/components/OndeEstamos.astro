---
import { negocio, linkComoChegar } from '../config';

const { endereco, horario, cidadesAtendidas, cidadesAtendidasResumo } = negocio;
---

<section class="onde" id="onde-estamos" aria-labelledby="titulo-onde">
  <div class="envelope">
    <h2 id="titulo-onde">Onde estamos</h2>

    <div class="onde__grade">
      <div class="onde__bloco">
        <h3>Endereço</h3>
        <address>
          {endereco.rua} — {endereco.bairro}<br />
          {endereco.cidade} - {endereco.uf}, {endereco.cep}
        </address>
        <a class="botao botao--secundario onde__mapa" href={linkComoChegar} target="_blank" rel="noopener">
          <svg class="botao__icone" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
            ></path>
          </svg>
          Como chegar<span class="so-leitor">{', abre o Google Maps em nova aba'}</span>
        </a>
      </div>

      <div class="onde__bloco">
        <h3>Horário</h3>
        <p>{horario.texto}</p>
      </div>

      <div class="onde__bloco">
        <h3>Cidades atendidas</h3>
        <p>{cidadesAtendidas.join(', ')} e {cidadesAtendidasResumo}.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .onde {
    background: var(--creme-rotulo);
  }

  .onde > .envelope {
    padding-block: 3rem;
  }

  h2 {
    font-size: var(--texto-g);
  }

  .onde__grade {
    display: grid;
    gap: 2rem;
    margin-top: 1.75rem;
  }

  h3 {
    font-size: 1.25rem;
  }

  address,
  .onde__bloco p {
    margin-top: 0.5rem;
    font-style: normal;
  }

  .onde__bloco :global(.onde__mapa) {
    margin-top: 1rem;
  }

  @media (min-width: 64rem) {
    .onde > .envelope {
      padding-block: 5rem;
    }

    h2 {
      font-size: 2.5rem;
    }

    .onde__grade {
      grid-template-columns: 4fr 3fr 5fr;
      gap: 3rem;
      margin-top: 2.25rem;
    }
  }
</style>
