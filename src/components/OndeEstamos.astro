---
import { getImage } from 'astro:assets';
import { negocio, linkComoChegar, whatsappExibicao } from '../config';
import serra from '../assets/logo/serra.svg';
// Mapa fixo (imagem), gerado por scripts/gerar-mapa.py: sem iframe e sem cookies.
import mapa from '../assets/mapa/mapa-piquete.png';
import mapaCelular from '../assets/mapa/mapa-piquete-celular.png';
import Filete from './Filete.astro';

const { endereco } = negocio;

// O celular recebe um recorte mais fechado do mesmo mapa, para os nomes das ruas continuarem legíveis.
const larguras = [560, 840, 1120];
const grandes = await Promise.all(larguras.map((width) => getImage({ src: mapa, width, format: 'webp', quality: 80 })));
const pequenos = await Promise.all([420].map((width) => getImage({ src: mapaCelular, width, format: 'webp', quality: 80 })));
const srcset = (lista: Awaited<ReturnType<typeof getImage>>[]) => lista.map((i) => `${i.src} ${i.attributes.width}w`).join(', ');
---

<section class="onde" id="onde-estamos" aria-labelledby="onde-titulo">
  <div class="envelope onde__grade">
    <div class="onde__cabeca">
      <h2 class="titulo-secao" id="onde-titulo">Onde estamos</h2>
      <Filete tom="escuro" class="filete-secao" />
    </div>

    <div class="onde__endereco">
      <address>
        <span class="onde__rua">{endereco.rua}</span>
        <span>{endereco.bairro}, {endereco.cidade} - {endereco.uf}</span>
        <span>CEP {endereco.cep}</span>
      </address>
      <!-- Link, não botão: botão cheio fica reservado para o WhatsApp. -->
      <a class="onde__mapa" href={linkComoChegar} target="_blank" rel="noopener">
        <svg class="onde__pino" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
        </svg>
        Como chegar
        <svg class="onde__seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        <span class="so-leitor">(abre o Google Maps em nova aba)</span>
      </a>
    </div>

    <figure class="onde__mapa-fig">
      <a class="onde__mapa-link" href={linkComoChegar} target="_blank" rel="noopener">
        <picture>
          <source media="(max-width: 760px)" srcset={srcset(pequenos)} sizes="calc(100vw - 2rem)" width={mapaCelular.width} height={mapaCelular.height} />
          <img
            src={grandes[1].src}
            srcset={srcset(grandes)}
            sizes="45vw"
            width={mapa.width}
            height={mapa.height}
            alt={`Mapa do centro de Piquete com um pino na ${endereco.rua}, perto da Avenida Conselheiro Rodrigues Alves`}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <span class="onde__mapa-selo" aria-hidden="true">Abrir no Google Maps</span>
        <span class="so-leitor">(abre o Google Maps em nova aba)</span>
      </a>
      <figcaption>
        Mapa: © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">colaboradores do OpenStreetMap</a>
      </figcaption>
    </figure>

    <dl class="onde__info">
      <div>
        <dt>Horário</dt>
        <dd>{negocio.horario.texto}</dd>
      </div>
      <div>
        <dt>WhatsApp</dt>
        <dd class="onde__numero" translate="no">{whatsappExibicao}</dd>
      </div>
      <div>
        <dt>Cidades atendidas</dt>
        <dd>{negocio.cidadesAtendidas.join(', ')} e {negocio.cidadesAtendidasResumo}.</dd>
      </div>
    </dl>
  </div>
  <div class="onde__serra" style={`--serra-img: url(${serra.src}); aspect-ratio: ${serra.width} / ${serra.height}`} aria-hidden="true"></div>
</section>

<style>
  .onde {
    position: relative;
    padding-top: calc(var(--respiro) + 1rem);
  }

  .onde__grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    grid-template-areas:
      'cabeca cabeca'
      'endereco mapa'
      'info mapa';
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .onde__cabeca {
    grid-area: cabeca;
  }

  .onde__endereco {
    grid-area: endereco;
  }

  .onde__mapa-fig {
    grid-area: mapa;
  }

  /* O mapa é um objeto sobre a mesa: canto arredondado, leve giro e sombra quente. */
  .onde__mapa-link {
    position: relative;
    display: block;
    border-radius: 1.75rem;
    overflow: hidden;
    rotate: 1.5deg;
    box-shadow: 0 24px 40px -24px rgb(43 26 18 / 0.55);
    transition: rotate 0.3s ease;
  }

  .onde__mapa-link:hover {
    rotate: 0deg;
  }

  .onde__mapa-link :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .onde__mapa-selo {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--creme);
    color: var(--tacho);
    font-weight: 600;
    box-shadow: 0 6px 16px -8px rgb(43 26 18 / 0.5);
  }

  .onde__mapa-fig figcaption {
    margin-top: 1rem;
    color: var(--caramelo);
    font-size: 1rem;
  }

  .onde__mapa-fig figcaption a {
    color: inherit;
  }

  address {
    display: grid;
    font-style: normal;
    font-size: var(--t-grande);
  }

  .onde__rua {
    margin-bottom: 0.5rem;
    color: var(--tacho);
    font: 600 clamp(2rem, 4.5vw, 3.75rem) / 1 var(--titulo);
    font-variation-settings: 'opsz' 144, 'SOFT' 0;
    letter-spacing: -0.02em;
  }

  .onde__mapa {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 3rem;
    margin-top: 1.5rem;
    color: var(--tacho);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(122 10 18 / 0.35);
    text-underline-offset: 0.3em;
  }

  .onde__mapa:hover {
    text-decoration-color: currentColor;
  }

  .onde__pino {
    width: 1.25rem;
    fill: currentColor;
  }

  .onde__seta {
    width: 0.9em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .onde__numero {
    font-variant-numeric: tabular-nums;
  }

  .onde__info {
    grid-area: info;
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  dt {
    color: var(--caramelo);
    font-weight: 700;
  }

  dd {
    margin-top: 0.35rem;
    font-size: 1.125rem;
  }

  /* A linha da serra, tirada da logo e pintada de verde, fecha a página antes do rodapé. */
  .onde__serra {
    width: min(55%, 26rem);
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
    background: var(--serra);
    mask: var(--serra-img) center / contain no-repeat;
  }

  @media (max-width: 760px) {
    .onde__grade {
      grid-template-columns: 1fr;
      grid-template-areas:
        'cabeca'
        'endereco'
        'mapa'
        'info';
    }

    .onde__mapa-link {
      rotate: none;
    }
  }
</style>
